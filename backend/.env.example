# AI Revenue Recovery Agent Environment Variables
# Copy this file to .env and fill in your keys if you want to use live LLMs.
# If keys are missing, the system will use a local deterministic parser.

# Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
